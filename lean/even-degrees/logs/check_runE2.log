def EvenCount.QkEven : ℕ → ℕ → ℕ :=
fun k m =>
  ∑ c ∈ Finset.range (k + 2),
    ∑ b ∈ Fintype.piFinset fun x => Finset.range (2 * k + 3) with 2 * c + 2 * ∑ u, b u = 2 * k + 2,
      (2 * k + 2).factorial / ((2 * c).factorial * ∏ u, (b u).factorial ^ 2)
structure EvenCount.PointedSetting.{u_1} (T : Type u_1) [Fintype T] (h : ℕ) : Type u_1
number of parameters: 3
fields:
  EvenCount.PointedSetting.neg : T → T
