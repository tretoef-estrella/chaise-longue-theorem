  EvenCount.PointedSetting.o : T
  EvenCount.PointedSetting.neg_o : self.neg self.o = self.o
  EvenCount.PointedSetting.eq_o_of_neg_eq : ∀ (u : T), self.neg u = u → u = self.o
  EvenCount.PointedSetting.card_eq : Fintype.card T = 2 * h + 1
constructor:
  EvenCount.PointedSetting.mk.{u_1} {T : Type u_1} [Fintype T] {h : ℕ} (neg : T → T)
    (neg_neg : ∀ (u : T), neg (neg u) = u) (o : T) (neg_o : neg o = o) (eq_o_of_neg_eq : ∀ (u : T), neg u = u → u = o)
    (card_eq : Fintype.card T = 2 * h + 1) : EvenCount.PointedSetting T h
def EvenCount.closedPointed.{u_1} : {T : Type u_1} →
  [inst : Fintype T] → [DecidableEq T] → {h : ℕ} → EvenCount.PointedSetting T h → (n : ℕ) → Finset (Fin n → T) :=
fun {T} [Fintype T] [DecidableEq T] {h} S n =>
  {M | (∀ (u : T), Fibres.cnt M u = Fibres.cnt M (S.neg u)) ∧ Even (Fibres.cnt M S.o)}
