@EvenMinus.lemma67_i_gen : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {ζ : F},
  ζ ≠ 0 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ),
      Disjoint (cls (cExt c) ζ) (cls (cExt c) ζ⁻¹) →
        ∀ (eA : Fin ((cls (cExt c) ζ).erase 0).card ≃ ↥((cls (cExt c) ζ).erase 0))
          (eB : Fin ((cls (cExt c) ζ⁻¹).erase 0).card ≃ ↥((cls (cExt c) ζ⁻¹).erase 0)),
          (∃ Φ,
              (∀ (i : Fin ((cls (cExt c) ζ).erase 0).card),
                  Φ (Bip.x F S.q i) = (algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ⁻¹ * tB S c (Wz S c ζ) ↑(eA i) - 1) ∧
                ∀ (l : Fin ((cls (cExt c) ζ⁻¹).erase 0).card),
                  Φ (Bip.z F S.q l) =
                    Ring.inverse ((algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ * tB S c (Wz S c ζ) ↑(eB l)) - 1) ∧
            ∃ Φ',
              (∀ (l : Fin ((cls (cExt c) ζ⁻¹).erase 0).card),
                  Φ' (Bip.x F S.q l) =
                    Ring.inverse ((algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ * tB S c (Wz S c ζ) ↑(eB l)) - 1) ∧
                ∀ (i : Fin ((cls (cExt c) ζ).erase 0).card),
                  Φ' (Bip.z F S.q i) = (algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ⁻¹ * tB S c (Wz S c ζ) ↑(eA i) - 1
@EvenMinus.lemma67_i_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ) (eA : Fin ((cls (cExt c) ζ).erase 0).card ≃ ↥((cls (cExt c) ζ).erase 0))
          (eB : Fin ((cls (cExt c) ζ⁻¹).erase 0).card ≃ ↥((cls (cExt c) ζ⁻¹).erase 0)),
          (∃ Φ,
              (∀ (i : Fin ((cls (cExt c) ζ).erase 0).card),
                  Φ (Bip.x F S.q i) = (algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ⁻¹ * tB S c (Wz S c ζ) ↑(eA i) - 1) ∧
                ∀ (l : Fin ((cls (cExt c) ζ⁻¹).erase 0).card),
                  Φ (Bip.z F S.q l) =
                    Ring.inverse ((algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ * tB S c (Wz S c ζ) ↑(eB l)) - 1) ∧
            ∃ Φ',
              (∀ (l : Fin ((cls (cExt c) ζ⁻¹).erase 0).card),
                  Φ' (Bip.x F S.q l) =
                    Ring.inverse ((algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ * tB S c (Wz S c ζ) ↑(eB l)) - 1) ∧
                ∀ (i : Fin ((cls (cExt c) ζ).erase 0).card),
                  Φ' (Bip.z F S.q i) = (algebraMap F ((boxS S c).Box (Wz S c ζ))) ζ⁻¹ * tB S c (Wz S c ζ) ↑(eA i) - 1
@EvenMinus.lemma67_ii_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          (∀ i ∈ (cls (cExt c) ζ).erase 0,
              ∀ l ∈ (cls (cExt c) ζ⁻¹).erase 0,
                tB S c (Wz S c ζ) i * tB S c (Wz S c ζ) l - 1 =
                    Ring.inverse (1 + ColPairs.zW S c ζ l) * (ColPairs.xW S c ζ i - ColPairs.zW S c ζ l) ∧
                  IsUnit (Ring.inverse (1 + ColPairs.zW S c ζ l))) ∧
            ∀ s ∈ (cls (cExt c) ζ ∪ cls (cExt c) ζ⁻¹).erase 0, IsUnit (tB S c (Wz S c ζ) s - 1)
@EvenMinus.lemma67_iii_bal_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          0 ∉ cls (cExt c) ζ ∪ cls (cExt c) ζ⁻¹ →
            ∀ {a : ℕ} (eA : Fin a ≃ ↥((cls (cExt c) ζ).erase 0)) (eB : Fin a ≃ ↥((cls (cExt c) ζ⁻¹).erase 0))
              (Φ : Bip.R F S.q a a ≃ₐ[F] (boxS S c).Box (Wz S c ζ)),
              (∀ (i : Fin a), Φ (Bip.x F S.q i) = ColPairs.xW S c ζ ↑(eA i)) →
                (∀ (l : Fin a), Φ (Bip.z F S.q l) = ColPairs.zW S c ζ ↑(eB l)) →
                  Ideal.map Φ (Bip.Ibal F S.q a) = Icz S c ζ
@EvenMinus.lemma67_iii_ph_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          0 ∈ cls (cExt c) ζ⁻¹ →
            ∀ {m : ℕ} (eA : Fin (m + 1) ≃ ↥((cls (cExt c) ζ).erase 0)) (eB : Fin m ≃ ↥((cls (cExt c) ζ⁻¹).erase 0))
              (Φ : Bip.R F S.q (m + 1) m ≃ₐ[F] (boxS S c).Box (Wz S c ζ)),
              (∀ (i : Fin (m + 1)), Φ (Bip.x F S.q i) = ColPairs.xW S c ζ ↑(eA i)) →
                (∀ (l : Fin m), Φ (Bip.z F S.q l) = ColPairs.zW S c ζ ↑(eB l)) →
                  Ideal.map Φ (Bip.Iph F S.q m) = Icz S c ζ
@EvenMinus.lemma67_iii_ph'_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          0 ∈ cls (cExt c) ζ →
            ∀ {m : ℕ} (eA : Fin m ≃ ↥((cls (cExt c) ζ).erase 0)) (eB : Fin (m + 1) ≃ ↥((cls (cExt c) ζ⁻¹).erase 0))
              (Φ' : Bip.R F S.q (m + 1) m ≃ₐ[F] (boxS S c).Box (Wz S c ζ)),
              (∀ (l : Fin (m + 1)), Φ' (Bip.x F S.q l) = ColPairs.zW S c ζ ↑(eB l)) →
                (∀ (i : Fin m), Φ' (Bip.z F S.q i) = ColPairs.xW S c ζ ↑(eA i)) →
                  Ideal.map Φ' (Bip.Iph F S.q m) = Icz S c ζ
@EvenMinus.lemma67_iii_ne_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {ζ : F}
  (c : Fin (2 * k + 1) → ↥S.μ), (cls (cExt c) ζ).card ≠ (cls (cExt c) ζ⁻¹).card → Icz S c ζ = ⊥
@EvenMinus.lemma67_iv_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          (∀ (a : ℕ),
              0 ∉ cls (cExt c) ζ ∪ cls (cExt c) ζ⁻¹ →
                ((cls (cExt c) ζ).erase 0).card = a →
                  ((cls (cExt c) ζ⁻¹).erase 0).card = a →
                    Module.finrank F ↥(Icz S c ζ) =
                      Module.finrank F ↥(Submodule.restrictScalars F (Bip.Ibal F S.q a))) ∧
            (∀ (β : ℕ),
                0 ∈ cls (cExt c) ζ⁻¹ →
                  ((cls (cExt c) ζ).erase 0).card = β + 1 →
                    ((cls (cExt c) ζ⁻¹).erase 0).card = β →
                      Module.finrank F ↥(Icz S c ζ) =
                        Module.finrank F ↥(Submodule.restrictScalars F (Bip.Iph F S.q β))) ∧
              (∀ (α : ℕ),
                  0 ∈ cls (cExt c) ζ →
                    ((cls (cExt c) ζ).erase 0).card = α →
                      ((cls (cExt c) ζ⁻¹).erase 0).card = α + 1 →
                        Module.finrank F ↥(Icz S c ζ) =
                          Module.finrank F ↥(Submodule.restrictScalars F (Bip.Iph F S.q α))) ∧
                ((cls (cExt c) ζ).card ≠ (cls (cExt c) ζ⁻¹).card → Module.finrank F ↥(Icz S c ζ) = 0)
@EvenMinus.lemma67_vi_reps2 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          (cls (cExt c) ζ).card = (cls (cExt c) ζ⁻¹).card →
            (0 ∉ cls (cExt c) ζ ∪ cls (cExt c) ζ⁻¹ →
                Bip.Nbal ((cls (cExt c) ζ).erase 0).card S.q ≤ Module.finrank F ↥(Icz S c ζ)) ∧
              (0 ∈ cls (cExt c) ζ ∪ cls (cExt c) ζ⁻¹ →
                Bip.Nph (min ((cls (cExt c) ζ).erase 0).card ((cls (cExt c) ζ⁻¹).erase 0).card) S.q ≤
                  Module.finrank F ↥(Icz S c ζ))
@EvenMinus.lemma97 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ {ζ : F},
      ζ ∈ R →
        ∀ (c : Fin (2 * k + 1) → ↥S.μ),
          (cls (cExt c) ζ).card = (cls (cExt c) ζ⁻¹).card →
            Bip.Nbal (cls (cExt c) ζ).card S.q ≤ Module.finrank F ↥(Icz S c ζ)
@EvenMinus.lemma98 : ∀ {F : Type u_1} [inst : Field F] {S : ColSetting F} {k : ℕ},
  S.p ≠ 2 → ∀ (c : Fin (2 * k + 1) → ↥S.μ), NS S 1 (cls (cExt c) 1).card ≤ Module.finrank F ↥(IcS S c 1)
@EvenMinus.lemmaM1 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ) {n : ℕ} (e : Fin n ≃ ↥(WS S c (-1))),
      ∃ Ψ,
        ∀ (i : Fin n),
          Ψ ((Ideal.Quotient.mk (Peel.powIdeal F (S.q + 1) n)) (MvPolynomial.X i)) =
            -(boxS S c).t (WS S c (-1)) (e i) - Ring.inverse (-(boxS S c).t (WS S c (-1)) (e i))
@EvenMinus.lemmaM2 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ),
      (∀ (s : ↥(WS S c (-1))), IsUnit ((boxS S c).t (WS S c (-1)) s - 1)) ∧
        ∀ (i l : ↥(WS S c (-1))),
          ∃ u,
            (boxS S c).t (WS S c (-1)) i * (boxS S c).t (WS S c (-1)) l - 1 =
              ↑u * (EvenMinus.yM (boxS S c) (WS S c (-1)) i + EvenMinus.yM (boxS S c) (WS S c (-1)) l)
@EvenMinus.lemmaM3 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {A : Type u_2} [inst_1 : CommRing A]
  [Algebra F A] (a b : A),
  (a + b) ^ (S.q - 1) = ∑ u ∈ Finset.range S.q, (-1) ^ u * a ^ u * b ^ (S.q - 1 - u) ∧
    ColOne.Dab (S.q + 1) a b = ∑ u ∈ Finset.range S.q, (-1) ^ u * a ^ u * b ^ (S.q - 1 - u)
@EvenMinus.add_pow_eq_Dab : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {A : Type u_2} [inst_1 : CommRing A]
  [Algebra F A] (a b : A), (a + b) ^ (S.q - 1) = ColOne.Dab (S.q + 1) a b
@EvenMinus.D_succ_eq : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {m : ℕ} (a b : Fin m),
  Tight.D F (S.q + 1) a b = (Tight.y F (S.q + 1) a + Tight.y F (S.q + 1) b) ^ (S.q - 1)
@EvenMinus.lemmaM4 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ) (P : PerfMatch ↥(cls (cExt c) (-1))), ∃ u, gPS S c (-1) P = ↑u * EvenMinus.DPM S c P
@EvenMinus.lemmaM4_coord : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ} {ι : Type u_2}
  [inst_1 : Fintype ι] [inst_2 : LinearOrder ι] {c : Fin (2 * k + 1) → ↥S.μ} (hneg : -1 ≠ 1)
  (ē : ι ≃o ↥(cls (cExt c) (-1))) {n : ℕ} (e : Fin n ≃ ↥(WS S c (-1))) (κ : ι → Fin n),
  (∀ (a : ι), ↑(ē a) ≠ 0 → (↑(e (κ a))).succ = ↑(ē a)) →
    ∀ (P : PerfMatch ι),
      ∃ u,
        gPS S c (-1) (EvenMinus.conjPMT ē.toEquiv P) =
          ↑u *
            (EvenMinus.PsiMW S hneg c e) ((Ideal.Quotient.mk (Peel.powIdeal F (S.q + 1) n)) (EvenMinus.fpolyM S ē κ P))
@EvenMinus.lemmaM5 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ) {j : ℕ},
      0 ∈ cls (cExt c) (-1) →
        (cls (cExt c) (-1)).card = 2 * j + 2 →
          Module.finrank F ↥(IcS S c (-1)) =
              Module.finrank F ↥(Submodule.restrictScalars F (TheoremB.DIdeal F (S.q + 1) j)) ∧
            EvenCount.QkEven j (S.q + 1) ≤ Module.finrank F ↥(IcS S c (-1))
@EvenMinus.lemmaM6 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ) {j : ℕ},
      0 ∉ cls (cExt c) (-1) →
        (cls (cExt c) (-1)).card = 2 * j + 2 →
          Module.finrank F ↥(IcS S c (-1)) =
              Module.finrank F
                ↥(Submodule.restrictScalars F
                    (OddPatterns.VSAll F ((S.q - 1) / 2) (2 * j + 2) {(OddShapes.emptyPart, false)})) ∧
            EvenCount.QkEven j (S.q + 1) ≤ Module.finrank F ↥(IcS S c (-1))
@EvenMinus.lemma99 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ},
  -1 ≠ 1 → ∀ (c : Fin (2 * k + 1) → ↥S.μ), NS S (-1) (cls (cExt c) (-1)).card ≤ Module.finrank F ↥(IcS S c (-1))
@EvenMinus.S1 : ∀ {F : Type u_1} [inst : Field F] (S : ColSetting F) {k : ℕ} {R : Finset F},
  IsReps2 S R →
    ∀ (c : Fin (2 * k + 1) → ↥S.μ),
      (∃ J, Compatible (cExt c) J) →
        (S.p ≠ 2 → NS S 1 (cls (cExt c) 1).card ≤ Module.finrank F ↥(IcS S c 1)) ∧
          (-1 ≠ 1 → NS S (-1) (cls (cExt c) (-1)).card ≤ Module.finrank F ↥(IcS S c (-1))) ∧
            ∀ ζ ∈ R, Bip.Nbal (cls (cExt c) ζ).card S.q ≤ Module.finrank F ↥(Icz S c ζ)
