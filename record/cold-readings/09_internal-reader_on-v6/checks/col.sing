ring r0=7,(s1,s2,s3,s4,s5),dp;
ideal box=s1^7,s2^7,s3^7,s4^7,s5^7;
qring Q=std(box);
poly t1=s1+(1);
poly t2=s2+(2);
poly t3=s3+(2);
poly t4=s4+(4);
poly t5=s5+(4);
proc phi(poly u) { poly r=1; poly pw=1; int e; for(e=1;e<=20;e++){pw=reduce(pw*u,std(0)); r=r+pw;} return(r);}
poly g0=(t1-1)*(t3-1)*phi(t2*t3)*(t5-1)*phi(t4*t5);
poly g1=(t1-1)*(t4-1)*phi(t2*t4)*(t5-1)*phi(t3*t5);
poly g2=(t1-1)*(t5-1)*phi(t2*t5)*(t4-1)*phi(t3*t4);
poly g3=(t2-1)*(t3-1)*phi(t1*t3)*(t5-1)*phi(t4*t5);
poly g4=(t2-1)*(t4-1)*phi(t1*t4)*(t5-1)*phi(t3*t5);
poly g5=(t2-1)*(t5-1)*phi(t1*t5)*(t4-1)*phi(t3*t4);
poly g6=(t3-1)*(t2-1)*phi(t1*t2)*(t5-1)*phi(t4*t5);
poly g7=(t3-1)*(t4-1)*phi(t1*t4)*(t5-1)*phi(t2*t5);
poly g8=(t3-1)*(t5-1)*phi(t1*t5)*(t4-1)*phi(t2*t4);
poly g9=(t4-1)*(t2-1)*phi(t1*t2)*(t5-1)*phi(t3*t5);
poly g10=(t4-1)*(t3-1)*phi(t1*t3)*(t5-1)*phi(t2*t5);
poly g11=(t4-1)*(t5-1)*phi(t1*t5)*(t3-1)*phi(t2*t3);
poly g12=(t5-1)*(t2-1)*phi(t1*t2)*(t4-1)*phi(t3*t4);
poly g13=(t5-1)*(t3-1)*phi(t1*t3)*(t4-1)*phi(t2*t4);
poly g14=(t5-1)*(t4-1)*phi(t1*t4)*(t3-1)*phi(t2*t3);
ideal I=g0,g1,g2,g3,g4,g5,g6,g7,g8,g9,g10,g11,g12,g13,g14;
ideal G=std(I);
print("bal: expect 6*91=546"); print(7^5-vdim(G));
