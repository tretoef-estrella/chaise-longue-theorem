def gsDecl (ci : ConstantInfo) : Option Declaration :=
  match ci with
  | .thmInfo v =>
    let t : TheoremVal := {
      name := gsFresh v.name
      levelParams := v.levelParams
      type := v.type
      value := v.value
      all := [gsFresh v.name] }
    some (.thmDecl t)
  | .defnInfo v =>
    let d : DefinitionVal := {
      name := gsFresh v.name
      levelParams := v.levelParams
      type := v.type
      value := v.value
      hints := v.hints
      safety := v.safety
      all := [gsFresh v.name] }
    some (.defnDecl d)
  | .opaqueInfo v =>
    let o : OpaqueVal := {
      name := gsFresh v.name
      levelParams := v.levelParams
      type := v.type
      value := v.value
      isUnsafe := v.isUnsafe
      all := [gsFresh v.name] }
    some (.opaqueDecl o)
  | _ => none

