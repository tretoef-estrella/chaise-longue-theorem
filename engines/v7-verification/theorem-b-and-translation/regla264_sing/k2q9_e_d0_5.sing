option(redSB);
LIB "elim.lib";
ring R=3,(x(0..5)),dp;
ideal box=x(0)^9,x(1)^9,x(2)^9,x(3)^9,x(4)^9,x(5)^9;
ideal E=1; ideal Bn=1; ideal IJ;
IJ=x(0)+x(1),x(2)+x(4),x(3)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(1),x(2)+x(5),x(3)+x(4);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(2),x(1)+x(3),x(4)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(2),x(1)+x(4),x(3)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(3),x(1)+x(2),x(4)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(3),x(1)+x(4),x(2)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(3),x(1)+x(5),x(2)+x(4);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(4),x(1)+x(2),x(3)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(4),x(1)+x(3),x(2)+x(5);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(4),x(1)+x(5),x(2)+x(3);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(5),x(1)+x(2),x(3)+x(4);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(5),x(1)+x(3),x(2)+x(4);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(5),x(1)+x(4),x(2)+x(3);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
ideal A=std(E+box); Bn=std(Bn);
print("EXT q=9 k=2 |K|=13 A=" + string(vdim(A)) + " B=" + string(vdim(Bn)));
quit;
