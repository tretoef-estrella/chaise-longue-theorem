ring R=3,(y(1..5)),dp;
ideal I=y(1)^3,y(2)^3,y(3)^3,y(4)^3,y(5)^3;
I=I+(y(1)*y(3)*y(5)*(y(2)+y(3))^2*(y(4)+y(5))^2);
I=I+(y(1)*y(4)*y(5)*(y(2)+y(4))^2*(y(3)+y(5))^2);
I=I+(y(1)*y(5)*y(4)*(y(2)+y(5))^2*(y(3)+y(4))^2);
I=I+(y(2)*y(3)*y(5)*(y(1)+y(3))^2*(y(4)+y(5))^2);
I=I+(y(2)*y(4)*y(5)*(y(1)+y(4))^2*(y(3)+y(5))^2);
I=I+(y(2)*y(5)*y(4)*(y(1)+y(5))^2*(y(3)+y(4))^2);
I=I+(y(3)*y(2)*y(5)*(y(1)+y(2))^2*(y(4)+y(5))^2);
I=I+(y(3)*y(4)*y(5)*(y(1)+y(4))^2*(y(2)+y(5))^2);
I=I+(y(3)*y(5)*y(4)*(y(1)+y(5))^2*(y(2)+y(4))^2);
I=I+(y(4)*y(2)*y(5)*(y(1)+y(2))^2*(y(3)+y(5))^2);
I=I+(y(4)*y(3)*y(5)*(y(1)+y(3))^2*(y(2)+y(5))^2);
I=I+(y(4)*y(5)*y(3)*(y(1)+y(5))^2*(y(2)+y(3))^2);
I=I+(y(5)*y(2)*y(4)*(y(1)+y(2))^2*(y(3)+y(4))^2);
I=I+(y(5)*y(3)*y(4)*(y(1)+y(3))^2*(y(2)+y(4))^2);
I=I+(y(5)*y(4)*y(3)*(y(1)+y(4))^2*(y(2)+y(3))^2);
I=std(I);
print("YCO q=3 k=2 |K|=15 vdim=" + string(vdim(I)));
quit;
