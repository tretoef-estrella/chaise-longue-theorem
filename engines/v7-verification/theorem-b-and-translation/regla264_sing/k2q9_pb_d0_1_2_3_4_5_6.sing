option(redSB);
ring R=3,(y(1..5)),dp;
ideal bx=y(1)^8,y(2)^8,y(3)^8,y(4)^8,y(5)^8;
ideal G=1; ideal IJ;
IJ=y(1)+y(4),y(2)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(5),y(2)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(2),y(3)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(3),y(2)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(5),y(2)+y(3); G=intersect(G,IJ+bx);
IJ=y(1)+y(2),y(3)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(3),y(2)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(4),y(2)+y(3); G=intersect(G,IJ+bx);
G=std(G);
print("PBONE q=9 k=2 |K|=8 r=8 vdim=" + string(vdim(G)));
quit;
