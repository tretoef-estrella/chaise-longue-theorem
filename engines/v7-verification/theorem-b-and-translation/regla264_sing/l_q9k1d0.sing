ring R=3,(t(1..3)),dp;
ideal I=t(1)^9-1,t(2)^9-1,t(3)^9-1;
I=I+((t(2)-1)*(t(3)-1)*(1+(t(1)*t(3))^1+(t(1)*t(3))^2+(t(1)*t(3))^3+(t(1)*t(3))^4+(t(1)*t(3))^5+(t(1)*t(3))^6+(t(1)*t(3))^7+(t(1)*t(3))^8));
I=I+((t(3)-1)*(t(2)-1)*(1+(t(1)*t(2))^1+(t(1)*t(2))^2+(t(1)*t(2))^3+(t(1)*t(2))^4+(t(1)*t(2))^5+(t(1)*t(2))^6+(t(1)*t(2))^7+(t(1)*t(2))^8));
I=std(I);
print("LIT q=9 k=1 |K|=2 vdim=" + string(vdim(I)));
quit;
