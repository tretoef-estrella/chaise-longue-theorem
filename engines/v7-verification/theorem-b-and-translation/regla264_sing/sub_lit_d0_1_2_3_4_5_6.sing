ring R=3,(t(1..5)),dp;
ideal I=t(1)^3-1,t(2)^3-1,t(3)^3-1,t(4)^3-1,t(5)^3-1;
I=I+((t(3)-1)*(t(4)-1)*(t(5)-1)*(1+(t(1)*t(4))^1+(t(1)*t(4))^2)*(1+(t(2)*t(5))^1+(t(2)*t(5))^2));
I=I+((t(3)-1)*(t(5)-1)*(t(4)-1)*(1+(t(1)*t(5))^1+(t(1)*t(5))^2)*(1+(t(2)*t(4))^1+(t(2)*t(4))^2));
I=I+((t(4)-1)*(t(2)-1)*(t(5)-1)*(1+(t(1)*t(2))^1+(t(1)*t(2))^2)*(1+(t(3)*t(5))^1+(t(3)*t(5))^2));
I=I+((t(4)-1)*(t(3)-1)*(t(5)-1)*(1+(t(1)*t(3))^1+(t(1)*t(3))^2)*(1+(t(2)*t(5))^1+(t(2)*t(5))^2));
I=I+((t(4)-1)*(t(5)-1)*(t(3)-1)*(1+(t(1)*t(5))^1+(t(1)*t(5))^2)*(1+(t(2)*t(3))^1+(t(2)*t(3))^2));
I=I+((t(5)-1)*(t(2)-1)*(t(4)-1)*(1+(t(1)*t(2))^1+(t(1)*t(2))^2)*(1+(t(3)*t(4))^1+(t(3)*t(4))^2));
I=I+((t(5)-1)*(t(3)-1)*(t(4)-1)*(1+(t(1)*t(3))^1+(t(1)*t(3))^2)*(1+(t(2)*t(4))^1+(t(2)*t(4))^2));
I=I+((t(5)-1)*(t(4)-1)*(t(3)-1)*(1+(t(1)*t(4))^1+(t(1)*t(4))^2)*(1+(t(2)*t(3))^1+(t(2)*t(3))^2));
I=std(I);
print("LIT q=3 k=2 |K|=8 vdim=" + string(vdim(I)));
quit;
