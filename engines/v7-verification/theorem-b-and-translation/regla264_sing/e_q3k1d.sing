option(redSB);
LIB "elim.lib";
ring R=3,(x(0..3)),dp;
ideal box=x(0)^3,x(1)^3,x(2)^3,x(3)^3;
ideal E=1; ideal Bn=1; ideal IJ;
IJ=x(0)+x(1),x(2)+x(3);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(2),x(1)+x(3);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
IJ=x(0)+x(3),x(1)+x(2);
E=intersect(E,IJ); Bn=intersect(Bn,IJ+box);
ideal A=std(E+box); Bn=std(Bn);
print("EXT q=3 k=1 |K|=3 A=" + string(vdim(A)) + " B=" + string(vdim(Bn)));
quit;
