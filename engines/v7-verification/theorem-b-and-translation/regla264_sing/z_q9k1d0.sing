option(redSB);
ring RBONE=3,(y(1..3)),dp;
ideal bx=y(1)^9,y(2)^9,y(3)^9;
ideal G=1; ideal IJ;
IJ=y(1)+y(3); G=intersect(G,IJ+bx);
IJ=y(1)+y(2); G=intersect(G,IJ+bx);
G=std(G); print("BONE " + string(vdim(G)));
ring RZ=3,(y(1..3)),dp;
ideal bx=y(1)^8,y(2)^8,y(3)^8;
ideal G=1; ideal IJ;
IJ=y(1)+y(3); G=intersect(G,IJ+bx);
IJ=y(1)+y(2); G=intersect(G,IJ+bx);
G=std(G); print("Z " + string(vdim(G)));
ring RZ02=3,(y(1..1)),dp;
ideal bx=y(1)^8;
ideal G=1; ideal IJ;
IJ=0; G=intersect(G,IJ+bx);
G=std(G); print("Z02 " + string(vdim(G)));
ring RZ03=3,(y(1..1)),dp;
ideal bx=y(1)^8;
ideal G=1; ideal IJ;
IJ=0; G=intersect(G,IJ+bx);
G=std(G); print("Z03 " + string(vdim(G)));
ring RZ12=3,(y(1..1)),dp;
ideal bx=y(1)^8;
ideal G=1; ideal IJ;
IJ=0; G=intersect(G,IJ+bx);
G=std(G); print("Z12 " + string(vdim(G)));
ring RZ13=3,(y(1..1)),dp;
ideal bx=y(1)^8;
ideal G=1; ideal IJ;
IJ=0; G=intersect(G,IJ+bx);
G=std(G); print("Z13 " + string(vdim(G)));
quit;