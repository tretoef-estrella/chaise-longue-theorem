option(redSB);
ring R=3,(y(1..5)),dp;
ideal bx=y(1)^2,y(2)^2,y(3)^2,y(4)^2,y(5)^2;
ideal G=1; ideal IJ;
IJ=y(2)+y(4),y(3)+y(5); G=intersect(G,IJ+bx);
IJ=y(2)+y(5),y(3)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(3),y(4)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(4),y(3)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(5),y(3)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(2),y(4)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(4),y(2)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(5),y(2)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(2),y(3)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(3),y(2)+y(5); G=intersect(G,IJ+bx);
IJ=y(1)+y(5),y(2)+y(3); G=intersect(G,IJ+bx);
IJ=y(1)+y(2),y(3)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(3),y(2)+y(4); G=intersect(G,IJ+bx);
IJ=y(1)+y(4),y(2)+y(3); G=intersect(G,IJ+bx);
G=std(G);
print("PBONE q=3 k=2 |K|=14 r=2 vdim=" + string(vdim(G)));
quit;
