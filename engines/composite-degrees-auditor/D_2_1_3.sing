ring r = 3,(x1,x2,z1),dp;
ideal I0=x1^3,x2^3,z1^3,0;
print("D0 Z=0 dim="+string(27-vdim(std(I0))));
ideal I1=x1^3,x2^3,z1^3,(x1-z1)^2*1,(x2-z1)^2*1;
print("D1 Z=15 dim="+string(27-vdim(std(I1))));
ideal I2=x1^3,x2^3,z1^3,(x1-z1)^2*1,(x2-z1)^2*1,(x2-x1)*1;
print("D2 Z=21 dim="+string(27-vdim(std(I2))));
ideal I3=x1^3,x2^3,z1^3,1*1*1,1*1*1,(x1-z1)^2*1,(x2-z1)^2*1,(x2-x1)*1;
print("D3 Z=27 dim="+string(27-vdim(std(I3))));
quit;