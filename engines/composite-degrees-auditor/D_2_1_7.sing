ring r = 7,(x1,x2,z1),dp;
ideal I0=x1^7,x2^7,z1^7,0;
print("D0 Z=0 dim="+string(343-vdim(std(I0))));
ideal I1=x1^7,x2^7,z1^7,(x1-z1)^6*1,(x2-z1)^6*1;
print("D1 Z=91 dim="+string(343-vdim(std(I1))));
ideal I2=x1^7,x2^7,z1^7,(x1-z1)^6*1,(x2-z1)^6*1,(x2-x1)*1;
print("D2 Z=301 dim="+string(343-vdim(std(I2))));
ideal I3=x1^7,x2^7,z1^7,1*1*1,1*1*1,(x1-z1)^6*1,(x2-z1)^6*1,(x2-x1)*1;
print("D3 Z=343 dim="+string(343-vdim(std(I3))));
quit;