// Gate L: literal ring F_p[t1,t2,t3]/(t_i^m-1) modulo psi_J, k=1. Own engine (Singular), independent of Fable.
proc run(int m, int p) {
  ring r = p,(t1,t2,t3),dp;
  poly f1=0; poly f2=0; poly f3=0; int i;
  poly u1=t2*t3; poly u2=t1*t3; poly u3=t1*t2;
  for(i=0;i<m;i++){ f1=f1+u1^i; f2=f2+u2^i; f3=f3+u3^i; }
  // J=[[0,1],[2,3]]: (t1-1)(t3-1)phi(t2t3); J=[[0,2],[1,3]]: (t2-1)(t3-1)phi(t1t3); J=[[0,3],[1,2]]: (t3-1)(t2-1)phi(t1t2)
  ideal I = t1^m-1, t2^m-1, t3^m-1, (t1-1)*(t3-1)*f1, (t2-1)*(t3-1)*f2, (t3-1)*(t2-1)*f3;
  int v = vdim(std(I));
  print("m="+string(m)+" p="+string(p)+" quotient="+string(v)+" dim_ideal="+string(m^3-v)+" expected_Q="+string(3*(m-1)*(m-2)));
}
run(15,3); run(15,5); run(21,3); run(21,7); run(33,3); run(33,11); run(35,5); run(35,7); run(39,3); run(39,13); run(45,3); run(45,5); run(55,5); run(55,11);
quit;
