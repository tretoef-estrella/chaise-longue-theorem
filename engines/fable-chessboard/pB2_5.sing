ring r = 3, (a,b1,b2,c1,c2,c3,c4), dp;
proc elv(list vl, int k) { if (k < 0) {return(0);} if (k == 0) {return(1);} if (k > size(vl)) {return(0);}
  list u = delete(vl, size(vl)); return(elv(u, k) + vl[size(vl)] * elv(u, k-1)); }
poly PI = c1*c2*c3*c4*((1)*1*a^4+(-1)*(b1^1+b2^1)*a^3+(1)*(b1^2+b2^2)*a^2+(-1)*(b1^3+b2^3)*a^1+(1)*(b1^4+b2^4)*a^0) - (1)*(b1^4+b2^4)*(a+c1)*(a+c2)*(a+c3)*(a+c4);
