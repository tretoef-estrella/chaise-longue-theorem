ideal Aq = a^9; ideal SAq = std(Aq); "  claim A at q=9:", reduce(a^4*PI - (((a)^0*(-b2)^3+(a)^1*(-b2)^2+(a)^2*(-b2)^1+(a)^3*(-b2)^0)*(a^5*elv(list(b2,c1,c2,c3,c4),4)+a^6*elv(list(b2,c1,c2,c3,c4),3)+a^7*elv(list(b2,c1,c2,c3,c4),2)+a^8*elv(list(b2,c1,c2,c3,c4),1)) + ((a)^0*(-b1)^3+(a)^1*(-b1)^2+(a)^2*(-b1)^1+(a)^3*(-b1)^0)*(a^5*elv(list(b1,c1,c2,c3,c4),4)+a^6*elv(list(b1,c1,c2,c3,c4),3)+a^7*elv(list(b1,c1,c2,c3,c4),2)+a^8*elv(list(b1,c1,c2,c3,c4),1)) - a^8*c1*c2*c3*c4), SAq) == 0;
