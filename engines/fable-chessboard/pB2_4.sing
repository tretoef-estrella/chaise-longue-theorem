ideal J2 = elv(list(a,b1,b2,c1,c2,c3),1), elv(list(a,b1,b2,c1,c2,c3),3), elv(list(a,b1,b2,c1,c2,c3),4), elv(list(a,b1,b2,c1,c2,c3),5), elv(list(a,b1,b2,c1,c2,c3),6), b1*b2*c1*c2*c3, a*b2*c1*c2*c3, a*b1*c1*c2*c3, a*b1*b2*c2*c3, a*b1*b2*c1*c3, a*b1*b2*c1*c2, a^6; ideal S2 = std(J2); "L=4 m0=2: a^m0 * Pi_L in (e_1,e_3,e_>=3) + (x_[n]minus beta) + (a^(m0+L)):", reduce(a^2*PI, S2) == 0;
ideal J3 = elv(list(a,b1,b2,c1,c2,c3),1), elv(list(a,b1,b2,c1,c2,c3),3), elv(list(a,b1,b2,c1,c2,c3),4), elv(list(a,b1,b2,c1,c2,c3),5), elv(list(a,b1,b2,c1,c2,c3),6), b1*b2*c1*c2*c3, a*b2*c1*c2*c3, a*b1*c1*c2*c3, a*b1*b2*c2*c3, a*b1*b2*c1*c3, a*b1*b2*c1*c2, a^7; ideal S3 = std(J3); "L=4 m0=3: a^m0 * Pi_L in (e_1,e_3,e_>=3) + (x_[n]minus beta) + (a^(m0+L)):", reduce(a^3*PI, S3) == 0;
ideal J4 = elv(list(a,b1,b2,c1,c2,c3),1), elv(list(a,b1,b2,c1,c2,c3),3), elv(list(a,b1,b2,c1,c2,c3),4), elv(list(a,b1,b2,c1,c2,c3),5), elv(list(a,b1,b2,c1,c2,c3),6), b1*b2*c1*c2*c3, a*b2*c1*c2*c3, a*b1*c1*c2*c3, a*b1*b2*c2*c3, a*b1*b2*c1*c3, a*b1*b2*c1*c2, a^8; ideal S4 = std(J4); "L=4 m0=4: a^m0 * Pi_L in (e_1,e_3,e_>=3) + (x_[n]minus beta) + (a^(m0+L)):", reduce(a^4*PI, S4) == 0;
