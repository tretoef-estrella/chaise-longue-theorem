ring r = 3, (a,b1,b2,c1,c2,c3), dp;
proc elv(list vl, int k) { if (k < 0) {return(0);} if (k == 0) {return(1);} if (k > size(vl)) {return(0);}
  list u = delete(vl, size(vl)); return(elv(u, k) + vl[size(vl)] * elv(u, k-1)); }
poly PI = c1*c2*c3*((1)*1*a^3+(-1)*(b1^1+b2^1)*a^2+(1)*(b1^2+b2^2)*a^1+(-1)*(b1^3+b2^3)*a^0) - (-1)*(b1^3+b2^3)*(a+c1)*(a+c2)*(a+c3);
ideal J0 = elv(list(a,b1,b2,c1,c2,c3),1), elv(list(a,b1,b2,c1,c2,c3),3), elv(list(a,b1,b2,c1,c2,c3),4), elv(list(a,b1,b2,c1,c2,c3),5), elv(list(a,b1,b2,c1,c2,c3),6), b1*b2*c1*c2*c3, a*b2*c1*c2*c3, a*b1*c1*c2*c3, a*b1*b2*c2*c3, a*b1*b2*c1*c3, a*b1*b2*c1*c2, a^4; ideal S0 = std(J0); "L=4 m0=0: a^m0 * Pi_L in (e_1,e_3,e_>=3) + (x_[n]minus beta) + (a^(m0+L)):", reduce(a^0*PI, S0) == 0;
