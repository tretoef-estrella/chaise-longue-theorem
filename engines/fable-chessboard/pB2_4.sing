ideal J8 = elv(list(a,b1,b2,c1,c2,c3),1), elv(list(a,b1,b2,c1,c2,c3),3), elv(list(a,b1,b2,c1,c2,c3),4), elv(list(a,b1,b2,c1,c2,c3),5), elv(list(a,b1,b2,c1,c2,c3),6), b1*b2*c1*c2*c3, a*b2*c1*c2*c3, a*b1*c1*c2*c3, a*b1*b2*c2*c3, a*b1*b2*c1*c3, a*b1*b2*c1*c2, a^12; ideal S8 = std(J8); "L=4 m0=8: a^m0 * Pi_L in (e_1,e_3,e_>=3) + (x_[n]minus beta) + (a^(m0+L)):", reduce(a^8*PI, S8) == 0;
ideal Aq = a^9; ideal SAq = std(Aq); "  claim A at q=9:", reduce(a^5*PI - (((a)^0*(-b2)^2+(a)^1*(-b2)^1+(a)^2*(-b2)^0)*(a^6*elv(list(b2,c1,c2,c3),3)+a^7*elv(list(b2,c1,c2,c3),2)+a^8*elv(list(b2,c1,c2,c3),1)) + ((a)^0*(-b1)^2+(a)^1*(-b1)^1+(a)^2*(-b1)^0)*(a^6*elv(list(b1,c1,c2,c3),3)+a^7*elv(list(b1,c1,c2,c3),2)+a^8*elv(list(b1,c1,c2,c3),1)) - a^8*c1*c2*c3), SAq) == 0;
ideal Aq = a^27; ideal SAq = std(Aq); "  claim A at q=27:", reduce(a^23*PI - (((a)^0*(-b2)^2+(a)^1*(-b2)^1+(a)^2*(-b2)^0)*(a^24*elv(list(b2,c1,c2,c3),3)+a^25*elv(list(b2,c1,c2,c3),2)+a^26*elv(list(b2,c1,c2,c3),1)) + ((a)^0*(-b1)^2+(a)^1*(-b1)^1+(a)^2*(-b1)^0)*(a^24*elv(list(b1,c1,c2,c3),3)+a^25*elv(list(b1,c1,c2,c3),2)+a^26*elv(list(b1,c1,c2,c3),1)) - a^26*c1*c2*c3), SAq) == 0;
ideal Aq = a^81; ideal SAq = std(Aq); "  claim A at q=81:", reduce(a^77*PI - (((a)^0*(-b2)^2+(a)^1*(-b2)^1+(a)^2*(-b2)^0)*(a^78*elv(list(b2,c1,c2,c3),3)+a^79*elv(list(b2,c1,c2,c3),2)+a^80*elv(list(b2,c1,c2,c3),1)) + ((a)^0*(-b1)^2+(a)^1*(-b1)^1+(a)^2*(-b1)^0)*(a^78*elv(list(b1,c1,c2,c3),3)+a^79*elv(list(b1,c1,c2,c3),2)+a^80*elv(list(b1,c1,c2,c3),1)) - a^80*c1*c2*c3), SAq) == 0;
